---
import Layout from '../layouts/Layout.astro';
import Sunburst from '../components/Sunburst.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Steps from '../components/Steps.astro';
import CallToAction from '../components/CallToAction.astro';
import { packages, terms } from '../content.js';
---

<Layout>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy on-dark">
      <div class="hero-copy-inner">
        <p class="label">Branding • Consulting • Business Development</p>
        <h1 id="hero-title">
          <span class="line">Let’s start a</span>
          <span class="line">conversation.</span>
        </h1>
        <p class="lede">
          We bring people, businesses and opportunities into the same conversation. The rest is history.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Start a conversation</a>
          <a class="btn btn-dark" href="/neighborhood/">Meet the Neighborhood</a>
        </div>
      </div>
    </div>

    <div class="hero-art on-orange" aria-hidden="true">
      <div class="sun">
        <Sunburst rays={18} rayColor="var(--light-gold)" coreColor="var(--gold)" />
      </div>
      <div class="arch">
        <img class="arch-coin" src="/images/cvn-coin.png" alt="" width="500" height="500" />
      </div>
    </div>

    <div class="edge-band" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
  </section>

  <!-- Services -->
  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">What we do</p>
        <h2 id="services-title">One relationship. Every side of your business.</h2>
        <p class="lede">
          Most businesses need a planner, a designer, a developer and a marketer. We bring them into one conversation, so
          you are not managing four different people.
        </p>
      </div>
      <ServiceCards />
      <p class="more">
        <a href="/services/">See all eight departments</a>, from business plans and websites to job seeker support.
      </p>
    </div>
  </section>

  <!-- How we work -->
  <section class="section on-paper" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">How we work</p>
        <h2 id="how-title">Five steps, one conversation.</h2>
        <p class="lede">Every great idea starts with a conversation. Ours goes like this.</p>
      </div>
      <Steps />
    </div>
  </section>

  <!-- Packages -->
  <section class="section" aria-labelledby="packages-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Year-round support</p>
        <h2 id="packages-title">Pick a package. Keep the conversation going.</h2>
        <p class="lede">
          Our annual packages put a team in your corner for twelve months, with a 20% deposit to start and monthly or
          quarterly payments after that.
        </p>
      </div>
      <ul class="packages">
        {packages.map((p) => (
          <li class="sticker package">
            <h3>{p.name}</h3>
            <p class="for">{p.for}</p>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact/?topic=packages">Ask about packages and pricing</a>
      </div>
    </div>
  </section>

  <!-- The Neighborhood -->
  <section class="section on-orange neighborhood" aria-labelledby="hood-title">
    <div class="wrap hood-grid">
      <div>
        <p class="label">The Neighborhood</p>
        <h2 id="hood-title">Talk like neighbors. Work like experts.</h2>
        <p class="lede">
          We are a neighborhood, not a call center. Everyone here has a name, including you.
        </p>
        <a class="btn btn-dark" href="/neighborhood/">Meet the Neighborhood</a>
      </div>
      <dl class="terms">
        {terms.map((t) => (
          <div class="term">
            <dt>{t.word}</dt>
            <dd>{t.meaning}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="cta-spacer"></div>
  <CallToAction />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: min(760px, calc(100svh - 78px));
    position: relative;
  }

  .hero-copy {
    display: flex;
    align-items: center;
    padding: clamp(48px, 8vw, 96px) var(--gutter) clamp(72px, 9vw, 112px);
  }

  .hero-copy-inner {
    width: 100%;
    max-width: 620px;
    margin-left: auto;
  }

  .hero h1 {
    color: var(--cream);
    margin-bottom: 0.35em;
  }

  .hero h1 .line {
    display: block;
  }

  .hero h1 .line + .line {
    color: var(--orange);
  }

  .hero .lede {
    max-width: 34rem;
  }

  .hero-art {
    position: relative;
    overflow: hidden;
    min-height: 420px;
  }

  .sun {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 128%;
    transform: translateX(-50%);
  }

  .sun :global(.rays) {
    transform-origin: 50% 100%;
    animation: fan 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .arch {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: min(56%, 340px);
    aspect-ratio: 3 / 4.4;
    transform: translateX(-50%);
    background: var(--orange);
    border: 3px solid var(--espresso);
    border-bottom: 0;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
  }

  .arch-coin {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: 78%;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 6px 0 rgba(33, 27, 18, 0.25));
    animation: rise 1.3s 0.25s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
  }

  @keyframes fan {
    from {
      transform: scale(0.2) rotate(-20deg);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes rise {
    from {
      transform: translate(-50%, 115%);
    }
    to {
      transform: translate(-50%, 0);
    }
  }

  .edge-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-rows: 8px 8px 6px 8px;
  }

  .edge-band span:nth-child(1) {
    background: var(--light-gold);
  }

  .edge-band span:nth-child(2) {
    background: var(--gold);
  }

  .edge-band span:nth-child(3) {
    background: var(--cream);
  }

  .edge-band span:nth-child(4) {
    background: var(--orange);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-copy-inner {
      margin-left: 0;
    }

    .hero-copy {
      padding-bottom: 56px;
    }

    .hero-art {
      min-height: 340px;
    }

    .sun {
      width: 110%;
    }

    .arch {
      width: min(52%, 240px);
    }
  }

  /* ---------- Sections ---------- */
  .more {
    margin-top: 40px;
    font-size: 1.05rem;
  }

  .packages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 36px);
  }

  .package {
    padding: 32px 30px;
    background: var(--cream);
    border-top-width: 14px;
  }

  .package:nth-child(1) {
    border-top-color: var(--light-gold);
  }

  .package:nth-child(2) {
    border-top-color: var(--orange);
  }

  .package:nth-child(3) {
    border-top-color: var(--gold);
  }

  .package h3 {
    font-size: 2rem;
  }

  .package .for {
    font-family: var(--font-label);
    color: var(--sunset-deep);
    margin-bottom: 0.6em;
  }

  .package p:last-child {
    margin-bottom: 0;
    color: var(--ink-soft);
  }

  .hood-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .hood-grid .lede {
    margin-bottom: 28px;
  }

  .terms {
    margin: 0;
    display: grid;
    gap: 16px;
  }

  .term {
    background: var(--cream);
    border: var(--outline);
    border-radius: 22px;
    box-shadow: var(--pop);
    padding: 20px 24px;
  }

  .term dt {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .term dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .cta-spacer {
    height: clamp(64px, 9vw, 120px);
  }

  @media (max-width: 900px) {
    .packages {
      grid-template-columns: 1fr;
      max-width: 560px;
    }

    .hood-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
