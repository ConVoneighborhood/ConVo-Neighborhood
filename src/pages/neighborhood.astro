---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CallToAction from '../components/CallToAction.astro';
import { terms } from '../content.js';
---

<Layout
  title="The Neighborhood"
  description="Meet ConVo Neighborhood: our mission, the people we work with and the platforms we are building."
>
  <PageHeader
    label="The Neighborhood"
    title="ConVo is a conversation."
    lede="We just wanna start the conversation… the rest is history."
  />

  <section class="section" aria-labelledby="mission-title">
    <div class="wrap story">
      <div>
        <h2 id="mission-title">Ideas into opportunities.</h2>
        <p class="lede">
          Our mission is to help people and organizations turn ideas into opportunities through business consulting,
          creative work, technology, education and professional resources.
        </p>
        <p>
          ConVo Neighborhood started as a creative, entrepreneurial idea and grew into a firm with specialized departments.
          Most new businesses need a planner, a designer, a developer and a marketer, and few can afford to hire each one
          separately. We put all of them in the same conversation.
        </p>
        <p>
          We are building toward a business development firm where entrepreneurs, professionals and organizations find the
          resources, knowledge, services and relationships they need to start and grow.
        </p>
      </div>
      <figure class="coin-figure" aria-hidden="true">
        <img src="/images/cvn-coin.png" alt="" width="500" height="500" />
      </figure>
    </div>
  </section>

  <section class="section on-orange" aria-labelledby="words-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="words-title">Everyone here has a name.</h2>
        <p class="lede">These are the words we use for the people in our neighborhood.</p>
      </div>
      <dl class="terms">
        {terms.map((t) => (
          <div class="term">
            <dt>{t.word}</dt>
            <dd>{t.meaning}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="platforms-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Platforms we are building</p>
        <h2 id="platforms-title">We build our own, too.</h2>
        <p class="lede">
          Alongside client work, ConVo Neighborhood owns and operates its own platforms. What we learn building them goes
          straight into the work we do for you.
        </p>
      </div>
      <ul class="platforms">
        <li class="sticker platform">
          <h3>A Box of Businesses</h3>
          <p>A home for business opportunities, company information and business development resources.</p>
          <p class="status">Coming soon</p>
        </li>
        <li class="sticker platform">
          <h3>Another Showroom</h3>
          <p>A stage for brand presentations, creative showcases and promotional business content.</p>
          <p class="status">Coming soon</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section on-paper" aria-labelledby="join-title">
    <div class="wrap join">
      <div>
        <p class="label">Join the Neighborhood</p>
        <h2 id="join-title">Become a Resident or a Kinfolk.</h2>
      </div>
      <div>
        <p class="lede">
          We work with independent designers, developers, writers, marketers and consultants, and with partners and brand
          ambassadors who want to grow with us.
        </p>
        <a class="btn btn-dark" href="/contact/?topic=join">Tell us about yourself</a>
      </div>
    </div>
  </section>

  <div class="spacer"></div>
  <CallToAction />
</Layout>

<style>
  .story {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .coin-figure {
    margin: 0;
    padding: clamp(24px, 4vw, 48px);
    background: var(--orange);
    border: var(--outline);
    border-radius: 999px 999px 32px 32px;
    box-shadow: var(--pop);
  }

  .terms {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .term {
    background: var(--cream);
    border: var(--outline);
    border-radius: 24px;
    box-shadow: var(--pop);
    padding: 26px 26px 28px;
  }

  .term dt {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .term dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .platforms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 36px);
  }

  .platform {
    padding: 30px 30px 26px;
    background: var(--cream);
  }

  .platform p {
    color: var(--ink-soft);
  }

  .status {
    display: inline-block;
    margin: 4px 0 0;
    padding: 4px 14px;
    font-family: var(--font-label);
    font-size: 0.9rem;
    color: var(--espresso) !important;
    background: var(--light-gold);
    border: 2px solid var(--espresso);
    border-radius: var(--radius-pill);
  }

  .join {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 6vw, 80px);
    align-items: center;
  }

  .join .lede {
    margin-bottom: 24px;
  }

  .spacer {
    height: clamp(64px, 9vw, 120px);
  }

  @media (max-width: 900px) {
    .story,
    .join,
    .terms,
    .platforms {
      grid-template-columns: 1fr;
    }

    .coin-figure {
      max-width: 280px;
    }
  }
</style>
