<section class="section legal-body">
  <div class="wrap">
    <div class="prose">
      <slot />
    </div>
  </div>
</section>

<style>
  .prose {
    max-width: 46rem;
  }

  .prose :global(h2) {
    font-family: var(--font-label);
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 2em 0 0.5em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(ul) {
    margin: 0 0 1em;
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin-bottom: 0.3em;
  }

  .prose :global(li::marker) {
    color: var(--orange);
  }
</style>
